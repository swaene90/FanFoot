# Copy this file to .env and fill in your values
# .env is gitignored and never committed

# PostgreSQL connection string
DB_CONNECTION_STRING=Host=192.168.0.48;Port=5432;Database=fanfoot;Username=postgres;Password=your_password_here

# Ollama URL (defaults to http://192.168.0.48:11434/ if not set)
OLLAMA_URL=http://192.168.0.48:11434/

# Groq API key -- enables Groq models in the AI chat provider selector.
# Get one free at console.groq.com
GROQ_API_KEY=

# DeepSeek API key -- enables DeepSeek models in the AI chat provider selector.
# Get one at platform.deepseek.com.
DEEPSEEK_API_KEY=
