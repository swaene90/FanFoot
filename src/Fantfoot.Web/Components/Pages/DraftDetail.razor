@page "/league/{LeagueId}/draft"

<PageTitle>Draft — @league?.Name ?? "League"</PageTitle>

@if (league == null || draftInfo == null)
{
    <p class="text-muted">Loading...</p>
    return;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>@league.Name — Draft</h1>
            <div class="d-flex align-items-center gap-2">
                @{
                    var badgeClass = draftInfo.Status == "complete" ? "bg-success" : "bg-warning text-dark";
                    var badgeText = draftInfo.Status == "complete" ? "Complete" : "Pre-Draft";
                }
                <span class="badge @badgeClass">@badgeText</span>
                <span class="text-muted">· @draftInfo.Type draft · @totalPicks total picks</span>
            </div>
        </div>
        <div class="col-auto d-flex align-items-center">
            <select class="form-select form-select-sm" @bind="selectedTeamId">
                <option value="">All Teams</option>
                @foreach (var (rosterId, teamName) in teamOptions)
                {
                    <option value="@rosterId">@teamName</option>
                }
            </select>
        </div>
    </div>

    @if (draftInfo.Status == "pre_draft")
    {
        <h3>Draft Order</h3>
        <p class="text-muted">The draft hasn't happened yet. Here's the planned order.</p>
        @if (draftOrder != null && draftOrder.Count != 0)
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Round</th>
                            <th>Pick</th>
                            <th>Team</th>
                            <th>Manager</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (round, pick, teamName, managerName, origTeam) in draftOrder)
                        {
                            <tr>
                                <td>@round</td>
                                <td>@pick</td>
                                <td>
                                    @teamName
                                    @if (origTeam != null)
                                    {
                                        <small class="text-muted">(from @origTeam)</small>
                                    }
                                </td>
                                <td>@managerName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        else
        {
            <p class="text-muted">Draft order not available.</p>
        }
    }
    else
    {
        var filteredPicks = string.IsNullOrEmpty(selectedTeamId)
            ? picks
            : picks.Where(p => p.TeamId == selectedTeamId).ToList();

        <h3>Picks (@filteredPicks.Count)</h3>
        <table class="table table-striped">
            <thead>
                    <tr>
                        <th>Round</th>
                        <th>Pick</th>
                        <th>Team</th>
                        <th>Manager</th>
                        <th>Player</th>
                        <th>Position</th>
                        <th>NFL Team</th>
                        <th>Keeper</th>
                    </tr>
            </thead>
            <tbody>
                @if (filteredPicks.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted">No picks found.</td></tr>
                }
                else
                {
                    @foreach (var pick in filteredPicks.OrderBy(p => p.PickNumber))
                    {
                        var teamName = pick.TeamId != null && teamMap.TryGetValue(pick.TeamId, out var tn) ? tn : "—";
                        var origTeam = (string?)null;
                        if (slotOwnerMap.Count > 0 && pick.TeamId != null && int.TryParse(pick.TeamId, out var actualRosterId))
                        {
                            var numTeams = slotOwnerMap.Count;
                            var pickInRound = (pick.PickNumber - 1) % numTeams + 1;
                            var expectedSlot = isSnake && pick.Round % 2 == 0
                                ? numTeams - pickInRound + 1
                                : pickInRound;
                            var origRosterId = slotOwnerMap.GetValueOrDefault(expectedSlot);
                            if (origRosterId != 0 && actualRosterId != origRosterId && teamMap.TryGetValue(origRosterId.ToString(), out var ot))
                                origTeam = ot;
                        }
                        <tr>
                            <td>@pick.Round</td>
                            <td>@pick.PickNumber</td>
                            <td>
                                @teamName
                                @if (origTeam != null)
                                {
                                    <small class="text-muted">(from @origTeam)</small>
                                }
                            </td>
                            <td>@(pick.TeamId != null && managerMap.TryGetValue(pick.TeamId, out var mgr) ? mgr : "—")</td>
                            <td>@pick.PlayerName</td>
                            <td>@pick.Position</td>
                            <td>@pick.Team</td>
                            <td>@(pick.IsKeeper == true ? "Yes" : "")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter]
    public string LeagueId { get; set; } = string.Empty;

    private League? league;
    private SleeperDraftDto? draftInfo;
    private List<DraftPick> picks = [];
    private List<Team> teams = [];
    private string selectedTeamId = "";
    private int totalPicks;

    private Dictionary<string, string> teamMap = [];
    private Dictionary<string, string> ownerTeamMap = [];
    private Dictionary<string, string> managerMap = [];
    private Dictionary<string, string> userManagerMap = [];
    private List<(string RosterId, string TeamName)> teamOptions = [];
    private List<(int Round, int Pick, string TeamName, string ManagerName, string? OrigTeam)>? draftOrder;
    private Dictionary<int, int> slotOwnerMap = [];
    private bool isSnake;
    private Dictionary<(int RosterId, int Round), int> tradedPickMap = [];

    [Inject]
    private LeagueService LeagueService { get; set; } = default!;

    [Inject]
    private FantfootDbContext Db { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        league = await LeagueService.GetLeagueAsync(LeagueId);
        if (league == null) return;

        draftInfo = await LeagueService.GetDraftInfoAsync(LeagueId);
        if (draftInfo == null) return;

        isSnake = string.Equals(draftInfo.Type, "snake", StringComparison.OrdinalIgnoreCase);

        teams = await Db.Teams.Where(t => t.LeagueId == LeagueId).ToListAsync();
        var users = await Db.Users.Where(u => u.LeagueId == LeagueId).ToListAsync();
        var userDisplayMap = users.ToDictionary(u => u.Id, u => u.DisplayName ?? u.Id);
        teamMap = teams.ToDictionary(
            t => t.Id.Split('_').Last(),
            t => t.TeamName);
        ownerTeamMap = teams
            .Where(t => t.OwnerId != null)
            .ToDictionary(t => t.OwnerId!, t => t.TeamName);

        managerMap = [];
        userManagerMap = [];
        foreach (var team in teams)
        {
            var rosterId = team.Id.Split('_').Last();
            if (team.OwnerId != null && userDisplayMap.TryGetValue(team.OwnerId, out var displayName))
            {
                managerMap[rosterId] = displayName;
                userManagerMap[team.OwnerId] = displayName;
            }
        }

        teamOptions = teams
            .Select(t => (RosterId: t.Id.Split('_').Last(), t.TeamName))
            .OrderBy(x => x.TeamName)
            .ToList();

        if (draftInfo.SlotToRosterId != null)
        {
            slotOwnerMap = draftInfo.SlotToRosterId
                .ToDictionary(kvp => int.Parse(kvp.Key), kvp => kvp.Value);
        }

        var traded = await LeagueService.GetTradedPicksAsync(LeagueId);
        var leagueSeason = league.Season.ToString();
        foreach (var tp in traded)
        {
            if (tp.Season == leagueSeason)
                tradedPickMap[(tp.RosterId, tp.Round)] = tp.OwnerId;
        }

        if (draftInfo.Status == "complete")
        {
            picks = await LeagueService.ImportDraftPicksAsync(LeagueId);
            totalPicks = picks.Count;
        }
        else
        {
            totalPicks = (draftInfo.Settings?.Rounds ?? 0) * (draftInfo.Settings?.Teams ?? 0);
            BuildDraftOrder();
        }
    }

    private void BuildDraftOrder()
    {
        if (draftInfo?.SlotToRosterId != null)
        {
            var slots = draftInfo.SlotToRosterId
                .OrderBy(kvp => int.Parse(kvp.Key))
                .ToList();

            var numTeams = slots.Count;
            var rounds = draftInfo.Settings?.Rounds ?? 4;
            draftOrder = [];
            var pick = 1;

            for (var round = 1; round <= rounds; round++)
            {
                var roundSlots = isSnake && round % 2 == 0
                    ? slots.AsEnumerable().Reverse().ToList()
                    : slots;

                foreach (var (slot, rosterId) in roundSlots)
                {
                    var actualRosterId = tradedPickMap.TryGetValue((rosterId, round), out var tradedOwner) ? tradedOwner : rosterId;
                    var rosterIdStr = actualRosterId.ToString();
                    var teamName = teamMap.GetValueOrDefault(rosterIdStr, $"Team {actualRosterId}");
                    var managerName = managerMap.GetValueOrDefault(rosterIdStr, "—");
                    var origTeam = actualRosterId != rosterId
                        ? teamMap.GetValueOrDefault(rosterId.ToString(), $"Team {rosterId}")
                        : null;
                    draftOrder.Add((round, pick++, teamName, managerName, origTeam));
                }
            }
        }
        else if (draftInfo?.DraftOrder != null)
        {
            var order = draftInfo.DraftOrder
                .OrderBy(kvp => kvp.Value)
                .ToList();

            var numTeams = order.Count;
            var rounds = draftInfo.Settings?.Rounds ?? 4;
            draftOrder = [];
            var pick = 1;

            for (var round = 1; round <= rounds; round++)
            {
                var roundOrder = isSnake && round % 2 == 0
                    ? order.AsEnumerable().Reverse().ToList()
                    : order;

                foreach (var (userId, _) in roundOrder)
                {
                    var teamName = ownerTeamMap.GetValueOrDefault(userId, $"User {userId}");
                    var managerName = userManagerMap.GetValueOrDefault(userId, "—");
                    draftOrder.Add((round, pick++, teamName, managerName, null));
                }
            }
        }
    }
}
