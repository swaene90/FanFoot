@page "/league/{LeagueId}"

<PageTitle>@(league?.Name ?? "League")</PageTitle>

@if (league == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    return;
}

@{
    var ownerMap = users?.ToDictionary(u => u.Id, u => u.DisplayName ?? "Unknown") ?? [];
    var sortedTeams = teams?.OrderByDescending(t => t.Wins).ToList() ?? [];
}

<div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:1.5rem;">
    <div>
        <MudText Typo="Typo.h4">@league.Name</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Season @league.Season &middot; @league.TotalRosters teams &middot; @league.Source
        </MudText>
    </div>
    <div style="display:flex; gap:0.5rem; align-items:center;">
        @if (previousLeague != null)
        {
            <MudButton Href="@($"/league/{previousLeague.Id}")" Variant="Variant.Outlined" Size="Size.Small">
                &larr; @previousLeague.Season Season
            </MudButton>
        }
        else if (league.PreviousLeagueId != null)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="ImportPreviousSeason" Disabled="@importingPrev">
                @(importingPrev ? "Importing..." : $"Import {league.Season - 1} Season")
            </MudButton>
        }
        <MudButton Href="@($"/league/{league.Id}/draft")" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Draft
        </MudButton>
    </div>
</div>

<MudText Typo="Typo.h5" Class="mb-2">Teams</MudText>
<MudTable T="Team" Items="@sortedTeams" Striped="true" Hover="true" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Team</MudTh>
        <MudTh>Manager</MudTh>
        <MudTh>W</MudTh>
        <MudTh>L</MudTh>
        <MudTh>T</MudTh>
        <MudTh>PF</MudTh>
        <MudTh>PA</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Team">@context.TeamName</MudTd>
        <MudTd DataLabel="Manager">@(context.OwnerId != null && ownerMap.TryGetValue(context.OwnerId, out var mgr) ? mgr : "—")</MudTd>
        <MudTd DataLabel="W">@context.Wins</MudTd>
        <MudTd DataLabel="L">@context.Losses</MudTd>
        <MudTd DataLabel="T">@context.Ties</MudTd>
        <MudTd DataLabel="PF">@context.PointsFor.ToString("F1")</MudTd>
        <MudTd DataLabel="PA">@context.PointsAgainst.ToString("F1")</MudTd>
        <MudTd>
            <MudButton Href="@($"/league/{league.Id}/team/{context.Id}")" Size="Size.Small" Variant="Variant.Outlined">Roster</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No teams loaded.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public string LeagueId { get; set; } = string.Empty;

    private League? league;
    private List<Team>? teams;
    private List<User>? users;
    private League? previousLeague;
    private bool importingPrev;

    [Inject]
    private LeagueService LeagueService { get; set; } = default!;

    [Inject]
    private FantfootDbContext Db { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        league = await LeagueService.GetLeagueAsync(LeagueId);
        if (league != null)
        {
            teams = await Db.Teams.Where(t => t.LeagueId == LeagueId).ToListAsync();
            users = await Db.Users.Where(u => u.LeagueId == LeagueId).ToListAsync();
            if (league.PreviousLeagueId != null)
            {
                previousLeague = await LeagueService.GetLeagueAsync(league.PreviousLeagueId);
            }
        }
    }

    private async Task ImportPreviousSeason()
    {
        if (league?.PreviousLeagueId == null) return;
        importingPrev = true;

        var prevLeague = await LeagueService.ImportLeagueAsync(league.PreviousLeagueId);
        await LeagueService.ImportUsersAsync(prevLeague.Id);
        await LeagueService.ImportRostersAsync(prevLeague.Id);

        previousLeague = prevLeague;
        importingPrev = false;
    }
}
