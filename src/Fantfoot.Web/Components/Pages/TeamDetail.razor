@page "/league/{LeagueId}/team/{TeamId}"
@using System.Text.Json

<PageTitle>@team?.TeamName ?? "Team"</PageTitle>

@if (team == null)
{
    <p class="text-muted">Loading...</p>
    return;
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <a href="/league/@LeagueId" class="text-decoration-none">&larr; Back to @league?.Name</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h1>@team.TeamName</h1>
            <p class="text-muted">
                Manager: @managerName
                &middot; @team.Wins - @team.Losses - @team.Ties
                &middot; PF: @team.PointsFor.ToString("F1") PA: @team.PointsAgainst.ToString("F1")
            </p>
        </div>
    </div>

    @if (rosterPlayers.Count == 0)
    {
        <p class="text-muted">No players on roster.</p>
    }
    else
    {
        <h2>Starters</h2>
        <table class="table table-striped mb-4">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Pos</th>
                    <th>NFL Team</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in starters)
                {
                    <tr>
                        <td>@p.FullName</td>
                        <td>@p.Position</td>
                        <td>@p.Team</td>
                        <td>@StatusBadge(p.Status, p.InjuryStatus)</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2>Bench</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Pos</th>
                    <th>NFL Team</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in bench)
                {
                    <tr>
                        <td>@p.FullName</td>
                        <td>@p.Position</td>
                        <td>@p.Team</td>
                        <td>@StatusBadge(p.Status, p.InjuryStatus)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (reserve.Count > 0)
        {
            <h2>Reserve / IR</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Pos</th>
                        <th>NFL Team</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in reserve)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Position</td>
                            <td>@p.Team</td>
                            <td>@StatusBadge(p.Status, p.InjuryStatus)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (taxi.Count > 0)
        {
            <h2>Taxi Squad</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Pos</th>
                        <th>NFL Team</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in taxi)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Position</td>
                            <td>@p.Team</td>
                            <td>@StatusBadge(p.Status, p.InjuryStatus)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter]
    public string LeagueId { get; set; } = string.Empty;

    [Parameter]
    public string TeamId { get; set; } = string.Empty;

    private League? league;
    private Team? team;
    private string managerName = "";
    private List<Player> rosterPlayers = [];
    private List<Player> starters = [];
    private List<Player> bench = [];
    private List<Player> reserve = [];
    private List<Player> taxi = [];

    [Inject]
    private LeagueService LeagueService { get; set; } = default!;

    [Inject]
    private FantfootDbContext Db { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        league = await LeagueService.GetLeagueAsync(LeagueId);
        team = await Db.Teams.FindAsync(TeamId);

        if (team == null) return;

        var user = team.OwnerId != null
            ? await Db.Users.FirstOrDefaultAsync(u => u.Id == team.OwnerId)
            : null;
        managerName = user?.DisplayName ?? "—";

        var rosterIds = DeserializeIds(team.Roster);
        var starterIds = DeserializeIds(team.Starters);
        var reserveIds = DeserializeIds(team.Reserve);
        var taxiIds = DeserializeIds(team.Taxi);

        var allIds = rosterIds.Concat(reserveIds).Concat(taxiIds).Distinct().ToList();

        if (allIds.Count > 0)
        {
            rosterPlayers = await Db.Players
                .Where(p => allIds.Contains(p.Id))
                .ToListAsync();
        }

        var playerMap = rosterPlayers.ToDictionary(p => p.Id);

        starters = starterIds.Select(id => playerMap.GetValueOrDefault(id)).OfType<Player>().ToList();
        bench = rosterIds.Except(starterIds).Select(id => playerMap.GetValueOrDefault(id)).OfType<Player>().ToList();
        reserve = reserveIds.Select(id => playerMap.GetValueOrDefault(id)).OfType<Player>().ToList();
        taxi = taxiIds.Select(id => playerMap.GetValueOrDefault(id)).OfType<Player>().ToList();
    }

    private static List<string> DeserializeIds(string? json)
    {
        if (string.IsNullOrEmpty(json)) return [];
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? []; }
        catch { return []; }
    }

    private static RenderFragment StatusBadge(string? status, string? injuryStatus) => builder =>
    {
        if (status == "Active" && string.IsNullOrEmpty(injuryStatus)) return;

        var color = (injuryStatus ?? status) switch
        {
            "Out" => "danger",
            "Questionable" => "warning",
            "Doubtful" => "warning",
            "IR" => "secondary",
            "Suspended" => "dark",
            _ => "secondary"
        };

        var label = injuryStatus ?? status;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
