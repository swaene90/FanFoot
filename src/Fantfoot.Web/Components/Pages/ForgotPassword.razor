@page "/forgot-password"
@using Microsoft.AspNetCore.Identity

<PageTitle>Fantfoot - Reset Password</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    <h1 class="card-title mb-4">Reset Password</h1>
                    <p class="text-muted mb-4">Reset your password using your Sleeper User ID.</p>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    @if (success)
                    {
                        <div class="alert alert-success">Password reset successfully.</div>
                        <a href="/" class="btn btn-primary">Sign In</a>
                    }
                    else
                    {
                        <form @onsubmit="ResetPassword">
                            <div class="mb-3">
                                <input type="text" class="form-control form-control-lg"
                                       placeholder="Sleeper User ID"
                                       @bind="sleeperUserId" />
                            </div>
                            <div class="mb-3">
                                <input type="password" class="form-control form-control-lg"
                                       placeholder="New Password"
                                       @bind="newPassword" />
                            </div>
                            <div class="mb-3">
                                <input type="password" class="form-control form-control-lg"
                                       placeholder="Confirm New Password"
                                       @bind="confirmPassword" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100"
                                    disabled="@(!IsValid)">
                                Reset Password
                            </button>
                        </form>

                        <p class="mt-3 mb-0">
                            <a href="/" class="text-decoration-none">Back to Sign In</a>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string sleeperUserId = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? error;
    private bool success;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(sleeperUserId) &&
        !string.IsNullOrWhiteSpace(newPassword) &&
        !string.IsNullOrWhiteSpace(confirmPassword);

    [Inject]
    private FantfootDbContext Db { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task ResetPassword()
    {
        error = null;

        var trimmedSleeperId = sleeperUserId.Trim();
        var trimmedNewPassword = newPassword.Trim();
        var trimmedConfirm = confirmPassword.Trim();

        if (string.IsNullOrWhiteSpace(trimmedSleeperId) ||
            string.IsNullOrWhiteSpace(trimmedNewPassword) ||
            string.IsNullOrWhiteSpace(trimmedConfirm))
        {
            error = "All fields are required.";
            return;
        }

        if (trimmedNewPassword != trimmedConfirm)
        {
            error = "Passwords do not match.";
            return;
        }

        var localUser = await Db.LocalUsers.FindAsync(trimmedSleeperId);
        if (localUser == null)
        {
            error = "No account found with that Sleeper User ID.";
            return;
        }

        var hasher = new PasswordHasher<LocalUser>();
        localUser.PasswordHash = hasher.HashPassword(localUser, trimmedNewPassword);
        await Db.SaveChangesAsync();

        success = true;
    }
}
