@page "/"
@using Microsoft.AspNetCore.Identity
@implements IDisposable

<PageTitle>Fantfoot - Sign In</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    <h1 class="card-title mb-4">Fantfoot</h1>
                    <p class="text-muted mb-4">Track your Sleeper fantasy leagues.</p>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    @if (checkingSession)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (importing)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mb-1">Importing your leagues...</p>
                            <p class="text-muted small">@importMessage</p>
                        </div>
                    }
                    else
                    {
                        <form @onsubmit="SignIn">
                            <div class="mb-3">
                                <input type="text" class="form-control form-control-lg"
                                       placeholder="Sleeper User ID"
                                       @bind="sleeperUserId" />
                            </div>
                            <div class="mb-3">
                                <input type="password" class="form-control form-control-lg"
                                       placeholder="Password"
                                       @bind="password" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100"
                                    disabled="@(!IsValid || importing)">
                                Sign In
                            </button>
                        </form>
                    }

                    @if (!checkingSession && !importing)
                    {
                        <p class="text-muted small mt-3 mb-0">
                            Don't know your User ID?
                            <a href="https://sleeper.com/profile" target="_blank">Check your Sleeper profile</a>
                            &mdash; it's the ID in the URL.
                        </p>

                        <p class="mt-3 mb-0">
                            <a href="/forgot-password" class="text-decoration-none small">Forgot Password?</a>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string password = string.Empty;
    private string sleeperUserId = string.Empty;
    private string? error;
    private bool importing;
    private string importMessage = "";
    private bool checkingSession = true;
    private CancellationTokenSource? _cts;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(password) &&
        !string.IsNullOrWhiteSpace(sleeperUserId);

    [Inject]
    private FantfootDbContext Db { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private LeagueService LeagueService { get; set; } = default!;

    [Inject]
    private SleeperClient Sleeper { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _cts = new CancellationTokenSource();
        try
        {
            var userId = await JS.InvokeAsync<string>("fantfoot.getCookie", _cts.Token, "fantfoot_user");
            if (!string.IsNullOrEmpty(userId))
            {
                var localUser = await Db.LocalUsers.FindAsync([userId], _cts.Token);
                if (localUser != null)
                {
                    Navigation.NavigateTo($"/user/{localUser.SleeperUserId}", replace: true);
                    return;
                }
            }
        }
        catch
        {
        }

        checkingSession = false;
        StateHasChanged();
    }

    private async Task SignIn()
    {
        error = null;

        var trimmedPassword = password.Trim();
        var trimmedSleeperId = sleeperUserId.Trim();

        if (string.IsNullOrWhiteSpace(trimmedPassword) ||
            string.IsNullOrWhiteSpace(trimmedSleeperId))
        {
            error = "All fields are required.";
            return;
        }

        var hasher = new PasswordHasher<LocalUser>();
        var existing = await Db.LocalUsers.FindAsync(trimmedSleeperId);
        var isNew = false;

        if (existing != null)
        {
            var result = hasher.VerifyHashedPassword(existing, existing.PasswordHash, trimmedPassword);
            if (result == PasswordVerificationResult.Failed)
            {
                error = "Invalid password.";
                return;
            }

            if (result == PasswordVerificationResult.SuccessRehashNeeded)
            {
                existing.PasswordHash = hasher.HashPassword(existing, trimmedPassword);
            }
        }
        else
        {
            isNew = true;
            var localUser = new LocalUser
            {
                SleeperUserId = trimmedSleeperId,
                PasswordHash = hasher.HashPassword(new LocalUser(), trimmedPassword),
                CreatedAt = DateTime.UtcNow
            };
            Db.LocalUsers.Add(localUser);
        }

        await Db.SaveChangesAsync();

        await JS.InvokeVoidAsync("fantfoot.setCookie", "fantfoot_user", trimmedSleeperId, 7200);

        if (isNew)
        {
            importing = true;
            try
            {
                await ImportUserLeaguesAsync(trimmedSleeperId);
            }
            catch (Exception ex)
            {
                error = $"Leagues imported with errors: {ex.Message}";
            }
            finally
            {
                importing = false;
            }
        }

        Navigation.NavigateTo($"/user/{trimmedSleeperId}");
    }

    private async Task ImportUserLeaguesAsync(string userId)
    {
        var nflState = await Sleeper.GetNflStateAsync();
        var currentSeason = nflState?.Season;
        if (string.IsNullOrEmpty(currentSeason)) return;

        var seen = new HashSet<string>();

        async Task ImportSeason(string season)
        {
            var leagues = await Sleeper.GetUserLeaguesAsync(userId, season);
            if (leagues == null) return;

            foreach (var leagueDto in leagues)
            {
                if (!seen.Add(leagueDto.LeagueId)) continue;

                importMessage = $"{leagueDto.Name} ({season})";
                StateHasChanged();

                await LeagueService.ImportLeagueAsync(leagueDto.LeagueId);
                await LeagueService.ImportUsersAsync(leagueDto.LeagueId);
                await LeagueService.ImportRostersAsync(leagueDto.LeagueId);
            }
        }

        var season = int.Parse(currentSeason);
        await ImportSeason(currentSeason);
        await ImportSeason((season - 1).ToString());
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
