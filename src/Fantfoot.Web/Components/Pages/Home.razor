@page "/"
@implements IDisposable

<PageTitle>Fantfoot - Sign In</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-10">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudCard Elevation="2">
            <MudCardContent Class="pa-6">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Fantfoot</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                    Track your Sleeper fantasy leagues.
                </MudText>

                @if (!string.IsNullOrEmpty(error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
                }

                @if (checkingSession || loading)
                {
                    <div style="display:flex; flex-direction:column; align-items:center; padding: 2rem 0;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        @if (loading)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@loadingMessage</MudText>
                        }
                    </div>
                }
                else
                {
                    <form @onsubmit="SignIn">
                        <MudTextField T="string" @bind-Value="sleeperUserId"
                                      Placeholder="Sleeper Username"
                                      Variant="Variant.Outlined"
                                      Class="mb-4" />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@string.IsNullOrWhiteSpace(sleeperUserId)">
                            Sign In
                        </MudButton>
                    </form>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private const string AuthorizedLeagueId = "1354116239798046720";

    private string sleeperUserId = string.Empty;
    private string? error;
    private string loadingMessage = string.Empty;
    private bool checkingSession = true;
    private bool loading;
    private CancellationTokenSource? _cts;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private SleeperClient Sleeper { get; set; } = default!;
    [Inject] private LeagueService LeagueService { get; set; } = default!;
    [Inject] private FantfootDbContext Db { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _cts = new CancellationTokenSource();

        try
        {
            var userId = await JS.InvokeAsync<string?>("fantfoot.getCookie", _cts.Token, "fantfoot_user");
            if (!string.IsNullOrEmpty(userId))
            {
                var localUser = await Db.LocalUsers.FindAsync([userId], _cts.Token);
                if (localUser != null)
                {
                    Navigation.NavigateTo($"/user/{userId}", replace: true);
                    return;
                }
            }
        }
        catch { }

        checkingSession = false;
        StateHasChanged();
    }

    private async Task SignIn()
    {
        error = null;
        var userId = sleeperUserId.Trim();
        if (string.IsNullOrWhiteSpace(userId)) return;

        loading = true;
        loadingMessage = "Looking up your account...";
        StateHasChanged();

        try
        {
            var sleeperUser = await Sleeper.GetUserAsync(userId);
            if (sleeperUser == null || string.IsNullOrEmpty(sleeperUser.UserId))
                throw new Exception("Sleeper username not found.");

            userId = sleeperUser.UserId;

            loadingMessage = "Checking your leagues...";
            StateHasChanged();

            var nflState = await Sleeper.GetNflStateAsync();
            if (nflState == null) throw new Exception("Could not reach the Sleeper API.");

            var authorized = false;
            foreach (var season in new[] { nflState.Season, (int.Parse(nflState.Season) - 1).ToString() })
            {
                var leagues = await Sleeper.GetUserLeaguesAsync(userId, season);
                if (leagues != null && leagues.Any(l => l.LeagueId == AuthorizedLeagueId))
                {
                    authorized = true;
                    break;
                }
            }

            if (!authorized)
            {
                error = "You are not a member of the authorized league.";
                return;
            }

            var existing = await Db.LocalUsers.FindAsync(userId);
            if (existing == null)
            {
                loadingMessage = "Importing your leagues...";
                StateHasChanged();

                await ImportUserLeaguesAsync(userId, nflState.Season);

                Db.LocalUsers.Add(new LocalUser { SleeperUserId = userId, CreatedAt = DateTime.UtcNow });
                await Db.SaveChangesAsync();
            }

            await JS.InvokeVoidAsync("fantfoot.setCookie", "fantfoot_user", userId, 604800);
            Navigation.NavigateTo($"/user/{userId}", replace: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ImportUserLeaguesAsync(string userId, string currentSeason)
    {
        var seen = new HashSet<string>();
        foreach (var season in new[] { currentSeason, (int.Parse(currentSeason) - 1).ToString() })
        {
            var leagues = await Sleeper.GetUserLeaguesAsync(userId, season);
            if (leagues == null) continue;
            foreach (var league in leagues)
            {
                if (!seen.Add(league.LeagueId)) continue;
                loadingMessage = $"Importing {league.Name}...";
                StateHasChanged();
                await LeagueService.ImportLeagueAsync(league.LeagueId);
                await LeagueService.ImportUsersAsync(league.LeagueId);
                await LeagueService.ImportRostersAsync(league.LeagueId);
            }
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
