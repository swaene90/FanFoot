<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Fantfoot.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        window.fantfoot = {
            setCookie: function (name, value, maxAgeSeconds) {
                document.cookie = name + "=" + encodeURIComponent(value) + "; path=/; max-age=" + maxAgeSeconds;
            },
            getCookie: function (name) {
                var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                return match ? decodeURIComponent(match[2]) : null;
            },
            removeCookie: function (name) {
                document.cookie = name + "=; path=/; max-age=0";
            },
            scrollToBottom: function (el) {
                if (el) el.scrollTop = el.scrollHeight;
            },
            setBackground: function (isDark) {
                var bg = isDark ? '#000000' : '#FFFFFF';
                var text = isDark ? '#FFFFFF' : '#1C1F23';
                document.documentElement.style.backgroundColor = bg;
                document.body.style.backgroundColor = bg;
                document.documentElement.style.color = text;
                document.body.style.color = text;
                document.body.classList.toggle('dark-mode', isDark);
            }
        };
    </script>
</body>

</html>
