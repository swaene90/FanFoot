@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Dense="true" Style="@(_isDarkMode ? "border-bottom: 2px solid #0076B6;" : "")">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="color:inherit;">Fanfoot</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkMode" />
        <MudButton Color="Color.Inherit" OnClick="SignOut">Sign Out</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Style="@(_isDarkMode ? "border-right: 2px solid #0076B6;" : "")">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private FanfootDbContext Db { get; set; } = default!;

    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private string? _userId;
    private bool _initialized;

    // Detroit Lions white away jersey → light mode
    // Detroit Lions black alternate jersey → dark mode
    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0076B6",              // Honolulu Blue
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#B0B7BC",            // Silver
            SecondaryContrastText = "#1C1F23",
            Background = "#FFFFFF",           // White jersey
            BackgroundGray = "#F4F6F8",
            Surface = "#FFFFFF",
            AppbarBackground = "#0076B6",     // Blue helmet/stripe
            AppbarText = "#FFFFFF",
            DrawerBackground = "#EBF4FB",     // Light blue-tinted sidebar
            DrawerText = "#1C1F23",
            DrawerIcon = "#0076B6",
            TextPrimary = "#1C1F23",
            TextSecondary = "#5C6470",
            TextDisabled = "#9CA3AF",
            LinesDefault = "#E2E6EA",
            LinesInputs = "#B0B7BC",
            Divider = "#E2E6EA",
            DividerLight = "#F0F2F4",
            TableLines = "#E2E6EA",
            TableStriped = "#F0F7FC",         // Very light blue stripe
            TableHover = "#D6EEFA",
            ActionDefault = "#1C1F23",
            ActionDisabled = "rgba(0,0,0,0.26)",
            ActionDisabledBackground = "rgba(0,0,0,0.12)",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#0076B6",              // Honolulu Blue (on both jerseys)
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#B0B7BC",            // Silver
            SecondaryContrastText = "#000000",
            Background = "#000000",           // Black jersey
            BackgroundGray = "#000000",
            Surface = "#000000",
            AppbarBackground = "#000000",     // Black jersey top
            AppbarText = "#FFFFFF",
            DrawerBackground = "#000000",
            DrawerText = "#FFFFFF",
            DrawerIcon = "#4AA3D4",           // Lighter blue on dark
            TextPrimary = "#FFFFFF",
            TextSecondary = "#B0B7BC",        // Silver for muted text
            TextDisabled = "rgba(255,255,255,0.3)",
            LinesDefault = "#2A2A2A",
            LinesInputs = "#3A3A3A",
            Divider = "#2A2A2A",
            DividerLight = "#1F1F1F",
            TableLines = "#2A2A2A",
            TableStriped = "#111111",
            TableHover = "#0D2035",           // Dark Honolulu blue tint
            ActionDefault = "#FFFFFF",
            ActionDisabled = "rgba(255,255,255,0.26)",
            ActionDisabledBackground = "rgba(255,255,255,0.12)",
        }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        _userId = await JS.InvokeAsync<string?>("fanfoot.getCookie", "fanfoot_user");

        await GuardAsync();

        if (!string.IsNullOrEmpty(_userId))
        {
            var prefs = await Db.UserPreferences.FindAsync(_userId);
            if (prefs != null && _isDarkMode != prefs.IsDarkMode)
            {
                _isDarkMode = prefs.IsDarkMode;
                StateHasChanged();
            }
        }
        await ApplyBackground();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            _userId = await JS.InvokeAsync<string?>("fanfoot.getCookie", "fanfoot_user");
            await GuardAsync();
        });
    }

    private Task GuardAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        if (string.IsNullOrEmpty(_userId) && !string.IsNullOrEmpty(path))
            Navigation.NavigateTo("/", replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await ApplyBackground();

        if (string.IsNullOrEmpty(_userId)) return;

        var prefs = await Db.UserPreferences.FindAsync(_userId);
        if (prefs == null)
        {
            prefs = new UserPreferences { UserId = _userId };
            Db.UserPreferences.Add(prefs);
        }
        prefs.IsDarkMode = _isDarkMode;
        prefs.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task ApplyBackground()
    {
        await JS.InvokeVoidAsync("fanfoot.setBackground", _isDarkMode);
    }

    private async Task SignOut()
    {
        await JS.InvokeVoidAsync("fanfoot.removeCookie", "fanfoot_user");
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
