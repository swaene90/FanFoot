@page "/chat"
@using Fanfoot.Web.Services
@using Fanfoot.Infrastructure.Data
@using Fanfoot.Domain
@using Microsoft.EntityFrameworkCore

<PageTitle>AI Chat</PageTitle>

<div style="display:flex; flex-direction:column; height:calc(100vh - 48px - 2rem);">
    <MudPaper Elevation="0" Square="true" Style="padding:0.75rem; border-bottom:1px solid var(--mud-palette-divider); display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <MudText Typo="Typo.h6">AI Assistant</MudText>
        @if (leagues.Count > 0)
        {
            <MudSelect T="string" Value="@selectedLeagueId" ValueChanged="OnLeagueSelectChanged"
                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="min-width:220px; max-width:300px;">
                @foreach (var league in leagues)
                {
                    <MudSelectItem T="string" Value="@league.Id">@league.Name</MudSelectItem>
                }
            </MudSelect>
        }
        <MudSpacer />
        @if (sessions.Count > 0)
        {
            <MudMenu Label="History" Variant="Variant.Outlined" Size="Size.Small"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" MaxHeight="400">
                @foreach (var session in sessions)
                {
                    <MudMenuItem OnClick="@(async () => await LoadSession(session))">
                        <MudText Typo="Typo.body2" Style="font-weight:500; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@session.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@session.UpdatedAt.LocalDateTime.ToString("MMM d, h:mm tt")</MudText>
                    </MudMenuItem>
                }
            </MudMenu>
        }
        @if (messages.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="NewChat">New Chat</MudButton>
        }
    </MudPaper>

    <div style="flex:1; overflow-y:auto; padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem;" @ref="messagesContainer">
        @if (initializing)
        {
            <div style="display:flex; flex-direction:column; align-items:center; margin-top:3rem;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading league context...</MudText>
            </div>
        }
        else if (messages.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-10">
                Ask about your teams, players, or matchups.
            </MudText>
        }
        @foreach (var msg in messages)
        {
            <div style="display:flex; @(msg.IsUser ? "justify-content:flex-end" : "justify-content:flex-start");">
                <div class="@(msg.IsUser ? "chat-bubble-user" : "chat-bubble-ai")">@msg.Content</div>
            </div>
        }
        @if (loading)
        {
            <div style="display:flex; justify-content:flex-start;">
                <MudPaper Elevation="0" Style="padding:0.5rem 0.75rem; border-radius:12px; background-color:var(--mud-palette-background-grey); font-size:.9rem; display:flex; align-items:center; gap:0.5rem;">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    Thinking...
                </MudPaper>
            </div>
        }
    </div>

    <MudPaper Elevation="0" Square="true" Style="padding:0.75rem; border-top:1px solid var(--mud-palette-divider);">
        <div style="display:flex; gap:0.5rem; align-items:center;">
            <MudTextField T="string" @bind-Value="input"
                          Placeholder="Ask anything..."
                          Immediate="true"
                          Disabled="@loading"
                          OnKeyDown="HandleKeyDown"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Style="flex:1;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="Send"
                       Disabled="@(string.IsNullOrWhiteSpace(input) || loading)">
                Send
            </MudButton>
        </div>
    </MudPaper>
</div>

@code {
    [Inject] private ChatService ChatService { get; set; } = default!;
    [Inject] private FanfootDbContext Db { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool loading;
    private bool initializing;
    private string input = "";
    private string? userId;
    private string selectedLeagueId = "";
    private string? systemPrompt;
    private string currentSessionId = Guid.NewGuid().ToString();
    private List<(string Role, string Content)> history = [];
    private List<ChatMessage> messages = [];
    private List<League> leagues = [];
    private List<ChatSession> sessions = [];
    private ElementReference messagesContainer;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        initializing = true;
        StateHasChanged();

        userId = await JS.InvokeAsync<string?>("fanfoot.getCookie", "fanfoot_user");
        if (!string.IsNullOrEmpty(userId))
        {
            var teams = await Db.Teams.Where(t => t.OwnerId == userId).ToListAsync();
            var leagueIds = teams.Select(t => t.LeagueId).Distinct().ToList();
            var allLeagues = await Db.Leagues
                .Where(l => leagueIds.Contains(l.Id))
                .ToListAsync();
            var currentSeason = allLeagues.Max(l => l.Season);
            leagues = allLeagues
                .Where(l => l.Season == currentSeason)
                .OrderBy(l => l.Name)
                .ToList();

            if (leagues.Count > 0)
            {
                selectedLeagueId = leagues[0].Id;
                systemPrompt = await ChatService.GetLeagueContextAsync(selectedLeagueId, userId);
            }
            else
            {
                systemPrompt = await ChatService.GetUserContextAsync(userId);
            }

            sessions = await ChatService.GetSessionsAsync(userId);
        }

        initializing = false;
        StateHasChanged();
    }

    private async Task OnLeagueSelectChanged(string value)
    {
        selectedLeagueId = value;
        await OnLeagueChanged();
    }

    private async Task OnLeagueChanged()
    {
        messages.Clear();
        history.Clear();
        currentSessionId = Guid.NewGuid().ToString();

        systemPrompt = string.IsNullOrEmpty(selectedLeagueId)
            ? await ChatService.GetUserContextAsync(userId!)
            : await ChatService.GetLeagueContextAsync(selectedLeagueId, userId);
    }

    private void NewChat()
    {
        messages.Clear();
        history.Clear();
        currentSessionId = Guid.NewGuid().ToString();
    }

    private async Task LoadSession(ChatSession session)
    {
        history = ChatService.DeserializeHistory(session.MessagesJson);
        messages = history.Select(h => new ChatMessage(h.Content, h.Role == "user")).ToList();
        currentSessionId = session.Id;
        selectedLeagueId = session.LeagueId ?? "";
        systemPrompt = string.IsNullOrEmpty(selectedLeagueId)
            ? await ChatService.GetUserContextAsync(userId!)
            : await ChatService.GetLeagueContextAsync(selectedLeagueId, userId);
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await Send();
    }

    private async Task Send()
    {
        var question = input.Trim();
        if (string.IsNullOrWhiteSpace(question) || loading) return;

        input = "";
        messages.Add(new ChatMessage(question, true));
        history.Add(("user", question));
        loading = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var prompt = systemPrompt ?? "You are an AI assistant for a fantasy football tracker app.";
            var answer = await ChatService.AskAsync(prompt, history);
            history.Add(("assistant", answer));
            messages.Add(new ChatMessage(answer, false));

            if (!string.IsNullOrEmpty(userId))
            {
                var title = history.FirstOrDefault(h => h.Role == "user").Content ?? question;
                await ChatService.SaveSessionAsync(currentSessionId, userId, string.IsNullOrEmpty(selectedLeagueId) ? null : selectedLeagueId, title, history);
                sessions = await ChatService.GetSessionsAsync(userId);
            }
        }
        catch (Exception ex)
        {
            history.RemoveAt(history.Count - 1);
            messages.Add(new ChatMessage($"Error: {ex.Message}", false));
        }
        finally
        {
            loading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("fanfoot.scrollToBottom", messagesContainer); }
        catch { }
    }

    private class ChatMessage(string content, bool isUser)
    {
        public string Content { get; } = content;
        public bool IsUser { get; } = isUser;
    }
}
