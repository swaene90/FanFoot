@page "/user/{UserId}"

<PageTitle>@(user?.DisplayName ?? "User")</PageTitle>

@if (user == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudText Typo="Typo.h4" Class="mb-1">@user.DisplayName</MudText>
@if (!string.IsNullOrEmpty(user.RealName))
{
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">@user.RealName</MudText>
}

@if (teamsBySeason.Count == 0)
{
    <MudText Color="Color.Secondary">No teams found for this user.</MudText>
}
else
{
    @* Most recent season — always visible *@
    var (currentSeason, currentGroups) = teamsBySeason[0];
    <MudText Typo="Typo.h5" Class="mt-2 mb-3">@currentSeason Season</MudText>
    @foreach (var (league, teams) in currentGroups)
    {
        <MudCard Elevation="1" Class="mb-3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudLink Href="@($"/league/{league.Id}")" Typo="Typo.h6" Underline="Underline.None">@league.Name</MudLink>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable T="Team" Items="@teams" Striped="true" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Team</MudTh>
                        <MudTh>W</MudTh>
                        <MudTh>L</MudTh>
                        <MudTh>T</MudTh>
                        <MudTh>PF</MudTh>
                        <MudTh>PA</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Team">@context.TeamName</MudTd>
                        <MudTd DataLabel="W">@context.Wins</MudTd>
                        <MudTd DataLabel="L">@context.Losses</MudTd>
                        <MudTd DataLabel="T">@context.Ties</MudTd>
                        <MudTd DataLabel="PF">@context.PointsFor.ToString("F1")</MudTd>
                        <MudTd DataLabel="PA">@context.PointsAgainst.ToString("F1")</MudTd>
                        <MudTd>
                            <MudButton Href="@($"/league/{context.LeagueId}/team/{context.Id}")" Size="Size.Small" Variant="Variant.Outlined">Roster</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }

    @* Previous seasons — collapsible *@
    @if (teamsBySeason.Count > 1)
    {
        <MudExpansionPanels MultiExpansion="true" Class="mt-4">
            @for (var i = 1; i < teamsBySeason.Count; i++)
            {
                var (season, groups) = teamsBySeason[i];
                <MudExpansionPanel Text="@($"{season} Season")">
                    @foreach (var (league, teams) in groups)
                    {
                        <MudCard Elevation="1" Class="mb-3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudLink Href="@($"/league/{league.Id}")" Typo="Typo.h6" Underline="Underline.None">@league.Name</MudLink>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                <MudTable T="Team" Items="@teams" Striped="true" Hover="true" Dense="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Team</MudTh>
                                        <MudTh>W</MudTh>
                                        <MudTh>L</MudTh>
                                        <MudTh>T</MudTh>
                                        <MudTh>PF</MudTh>
                                        <MudTh>PA</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Team">@context.TeamName</MudTd>
                                        <MudTd DataLabel="W">@context.Wins</MudTd>
                                        <MudTd DataLabel="L">@context.Losses</MudTd>
                                        <MudTd DataLabel="T">@context.Ties</MudTd>
                                        <MudTd DataLabel="PF">@context.PointsFor.ToString("F1")</MudTd>
                                        <MudTd DataLabel="PA">@context.PointsAgainst.ToString("F1")</MudTd>
                                        <MudTd>
                                            <MudButton Href="@($"/league/{context.LeagueId}/team/{context.Id}")" Size="Size.Small" Variant="Variant.Outlined">Roster</MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
}

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private User? user;
    private List<(int Season, List<(League League, List<Team> Teams)> Groups)> teamsBySeason = [];

    [Inject]
    private UserService UserService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserService.GetUserAsync(UserId);
        if (user == null) return;

        teamsBySeason = await UserService.GetUserTeamsBySeasonAsync(UserId);
    }
}
